# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
out/
build/
*.tsbuildinfo

# Electron packaging
# ANCHORED: bare `release/` also matched packages/release — a real workspace that
# 8 other workspaces depend on — hiding all 33 of its files from git status entirely.
# P13C ROUND 17n — the BINARIES are build output; the handoff record is not.
#
# `/release/` excluded the whole tree, and git cannot re-include a file whose
# parent directory is excluded — so the two `release/windows/*.exe` rules added
# below LOOKED like they were doing the work and were doing nothing, and
# `git add release/windows/*.md` silently committed nothing. The founder build's
# engineering status, known limitations, acceptance checklist and release
# manifests are the accountability record for an artifact handed to an outside
# party; they belong in the repository. The 110MB installers do not.
/release/*
!/release/windows/
/release/windows/*
!/release/windows/*.md
!/release/windows/*.json
apps/*/release/
apps/desktop/out/
apps/desktop/dist/

# Logs
logs/
*.log
npm-debug.log*

# Environment & secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test coverage
coverage/

# Local infra data
.docker-data/

# Delivery/build artifacts — packaged zips are exports of in-tree source; never commit them
*.zip
*.tgz
*.tar.gz

# Desktop CST kernel is intentionally vendored and must be committed.
# It is a hash-pinned, unpublished frozen dependency (@neuropause/cst,
# SHA-256 293d056047346631c72dd117b50733162b5ae08448f3c2bdedd73703cbceb431)
# that `apps/desktop/package.json` resolves via `file:vendor/...`. Excluding it
# would make a fresh clone's `npm install` fail. This exception is intentional.
!apps/desktop/vendor/neuropause-cst-1.3.0.tgz

# Key material — never commit. Defence in depth; nothing matching these exists today.
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Generated at package time by generate-build-info.cjs; never commit
apps/desktop/resources/build-info.json

# Vite/Vitest temp configs. Normally deleted automatically; they survive when a
# build is interrupted or runs where the process cannot unlink its own files.
apps/*/electron.vite.config.*.mjs
**/vitest.config.ts.timestamp-*.mjs

# Regenerated by scripts/generate-notices.cjs on every package run.
apps/desktop/resources/THIRD-PARTY-NOTICES.md

# local dev stack (np-local-up.sh)
.env.local-stack
.np-local-backend.pid
.np-local-backend.log
