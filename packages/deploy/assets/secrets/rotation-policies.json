{
  "note": "Rotation POLICIES only. No secret values are stored here or anywhere in this repository.",
  "backend": "vault",
  "policies": [
    { "name": "database-credentials", "rotationDays": 30, "type": "dynamic" },
    { "name": "jwt-signing-key", "rotationDays": 90, "type": "signing" },
    { "name": "encryption-key", "rotationDays": 180, "type": "encryption" },
    { "name": "api-keys", "rotationDays": 90, "type": "api" },
    { "name": "oauth-secrets", "rotationDays": 180, "type": "oauth" },
    { "name": "tls-certificates", "rotationDays": 90, "type": "certificate" }
  ]
}
