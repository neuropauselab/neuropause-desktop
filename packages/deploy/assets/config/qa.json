{
  "environment": "qa",
  "featureFlags": { "aiWorkforce": true, "marketplace": true, "canaryUi": true, "betaFeatures": true },
  "aiProviders": { "default": "ollama", "ollamaUrl": "http://ollama:11434", "external": { "enabled": false } },
  "storage": { "objectStore": "minio", "bucket": "nems-qa", "endpointRef": "STORAGE_ENDPOINT" },
  "database": { "engine": "postgres", "poolMax": 8, "sslMode": "prefer", "urlRef": "DATABASE_URL" },
  "logging": { "level": "debug", "format": "json", "destination": "stdout" },
  "monitoring": { "metrics": "prometheus", "tracing": "otel", "endpointRef": "OTEL_EXPORTER_OTLP_ENDPOINT" },
  "security": { "hsts": false, "csp": true, "secureCookies": true, "sessionTimeoutMinutes": 120, "mfaRequired": false }
}
