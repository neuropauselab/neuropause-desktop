{
  "environment": "development",
  "featureFlags": { "aiWorkforce": true, "marketplace": true, "canaryUi": true, "betaFeatures": true },
  "aiProviders": { "default": "ollama", "ollamaUrl": "http://localhost:11434", "external": { "enabled": false } },
  "storage": { "objectStore": "minio", "bucket": "nems-dev", "endpointRef": "STORAGE_ENDPOINT" },
  "database": { "engine": "postgres", "poolMax": 5, "sslMode": "disable", "urlRef": "DATABASE_URL" },
  "logging": { "level": "debug", "format": "pretty", "destination": "stdout" },
  "monitoring": { "metrics": "prometheus", "tracing": "otel", "endpointRef": "http://localhost:4317" },
  "security": { "hsts": false, "csp": false, "secureCookies": false, "sessionTimeoutMinutes": 480, "mfaRequired": false }
}
