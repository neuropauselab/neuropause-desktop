# ──────────────────────────────────────────────────────────────────────────
# NeuroPause Desktop — environment template
# Copy to `.env` (root, for docker compose) and `apps/backend/.env` (backend).
# NEVER commit a real .env. Real provider secrets must live server-side only.
# ──────────────────────────────────────────────────────────────────────────

# --- Infrastructure (docker compose) ---
POSTGRES_USER=neuropause
POSTGRES_PASSWORD=neuropause_dev
POSTGRES_DB=neuropause

# --- Backend service ---
NODE_ENV=development
PORT=4000
# Public origin the desktop app uses to reach the backend.
PUBLIC_BACKEND_URL=http://127.0.0.1:4000

DATABASE_URL=postgres://neuropause:neuropause_dev@127.0.0.1:5432/neuropause
REDIS_URL=redis://127.0.0.1:6379

# JWT signing. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_TTL=900            # access token lifetime, seconds (15 min)
JWT_REFRESH_TTL=2592000       # refresh token lifetime, seconds (30 days)

# --- OAuth providers (server-side only; leave blank to disable a provider) ---
# Register a "Web application" client and set the redirect URI to:
#   {PUBLIC_BACKEND_URL}/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Apple Sign In requires an Apple Developer account (Services ID + key file).
# See docs/AUTHENTICATION.md — the client secret is a generated JWT, not a static value.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Billing: Razorpay (server-side only; billing stays disabled until these are set) ---
# Keys come from the Razorpay Dashboard; plan ids from the subscription plans you create.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_ENTERPRISE=

# --- Production docker compose (docker-compose.prod.yml) ---
# With the production stack, DATABASE_URL and REDIS_URL above are ignored — they are
# injected to point at the postgres/redis service containers. BACKEND_PORT sets the
# published host port (the container always listens on 4000).
BACKEND_PORT=4000

# --- Desktop-process variables (documented for completeness; NOT read by the backend) ---
# NEUROPAUSE_BACKEND_URL           Backend base URL (baked into packaged builds via npm run package)
# NEUROPAUSE_LLM_PROVIDER / NEUROPAUSE_OLLAMA_URL / NEUROPAUSE_OLLAMA_MODEL   Local AI engine
# NEUROPAUSE_CHANNEL / NEUROPAUSE_BUILD_COMMIT / NEUROPAUSE_BUILD_TIME        Packaging metadata
# NEUROPAUSE_PLUGINS_DIR           Override the plugin directory
# ANTHROPIC_API_KEY                Optional cloud-model path (desktop main process)
# NEUROPAUSE_LITELLM_URL / NEUROPAUSE_LITELLM_API_KEY   RESERVED (BRAIN-1, DECISIONS D-13).
#   A multi-provider LiteLLM proxy lane — NOT wired today. Absent = the lane is off;
#   Ollama (localhost default) + the Claude/OpenAI env lanes cover current use. A real
#   client is added only when a concrete multi-provider need appears, with a DECISIONS entry.
# Connector OAuth (public client ids may be baked into packaged builds; secrets NEVER):
# NEUROPAUSE_GITHUB_CLIENT_ID  / NEUROPAUSE_GITHUB_CLIENT_SECRET
# NEUROPAUSE_NOTION_CLIENT_ID  / NEUROPAUSE_NOTION_CLIENT_SECRET
# NEUROPAUSE_SLACK_CLIENT_ID   / NEUROPAUSE_SLACK_CLIENT_SECRET
# NEUROPAUSE_GOOGLE_CLIENT_ID  / NEUROPAUSE_GOOGLE_CLIENT_SECRET
