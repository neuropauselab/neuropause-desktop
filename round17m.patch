--- a/.github/workflows/windows-release.yml
+++ b/.github/workflows/windows-release.yml
@@ -96,14 +96,51 @@
         run: node scripts/verify-release-artifacts.cjs --platform win
         shell: bash
 
+      # ARTIFACTS FIRST. P13C ROUND 17m.
+      #
+      # This step used to sit BELOW the two publish steps. On 12 Aug the Windows
+      # build packaged and verified successfully, then `scp` to the droplet timed
+      # out (`connect to host 64.227.128.218 port 22: Connection timed out`,
+      # exit 255) and the job died — taking the installer with it. A 23-minute
+      # build produced a correct artifact and delivered nothing, because an
+      # unrelated third-party host was down.
+      #
+      # The build output is now saved BEFORE anything touches the network. No
+      # step after this one can cost us the thing the job exists to produce.
+      - name: Upload build artifacts
+        uses: actions/upload-artifact@v4
+        with:
+          name: neuropause-windows
+          path: |
+            apps/desktop/dist/*.exe
+            apps/desktop/dist/*.zip
+            apps/desktop/dist/*.yml
+            apps/desktop/dist/*.blockmap
+          if-no-files-found: error
+          retention-days: 14
+
       # Keep every build's output, tag or not, for inspection/download.
+      # PUBLISHING TO neuropause033.com IS OFF. P13C ROUND 17m.
+      #
+      # Founder-test builds are handed over as a direct download first; the
+      # public download page is turned on afterwards, deliberately. Set the repo
+      # variable PUBLISH_TO_SITE to 'true' to re-enable — the secret's presence
+      # is no longer sufficient on its own, because "a key exists" was never the
+      # same question as "we intend to publish this build".
+      #
+      # `continue-on-error` because the comment below used to claim this step
+      # "never fails the build" while nothing in the step made that true. An
+      # unreachable droplet is now what it should always have been: a warning on
+      # a green build, not the loss of the artifact.
       # Self-hosted download (Option C): copy the Windows installer to the droplet
       # so it's served from neuropause033.com/downloads/ with no GitHub login.
-      # Runs only if the deploy secrets are present, and never fails the build.
+      # Gated on PUBLISH_TO_SITE (see above) and marked continue-on-error, so it
+      # genuinely cannot fail the build — which is what this line used to claim.
       - name: Publish installer to neuropause033.com
         env:
           DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
-        if: ${{ env.DEPLOY_SSH_KEY != '' }}
+        if: ${{ vars.PUBLISH_TO_SITE == 'true' && env.DEPLOY_SSH_KEY != '' }}
+        continue-on-error: true
         shell: bash
         run: |
           echo "$DEPLOY_SSH_KEY" > deploy_key
@@ -125,7 +162,8 @@
       # present; the trailing curl proves the feed is actually reachable over
       # HTTPS (fails the release if the server hides /updates/).
       - name: Publish update feed to neuropause033.com
-        if: ${{ env.DEPLOY_SSH_KEY != '' && startsWith(github.ref, 'refs/tags/') }}
+        if: ${{ vars.PUBLISH_TO_SITE == 'true' && env.DEPLOY_SSH_KEY != '' && startsWith(github.ref, 'refs/tags/') }}
+        continue-on-error: true
         env:
           DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
         shell: bash
