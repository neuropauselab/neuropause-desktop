{
  "extends": "../../tsconfig.base.json",
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*"],
  "exclude": ["src/main/**/*.test.ts", "src/main/**/*.mts"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@neuropause/shared": ["../../packages/shared/src/index.ts"],
      "@neuropause/companion-protocol": ["../../packages/companion-protocol/src/index.ts"]
    }
  }
}
