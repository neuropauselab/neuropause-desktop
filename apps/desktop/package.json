{
  "name": "@neuropause/desktop",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "NeuroPause Desktop \u2014 the AI operating layer (Electron + React + TypeScript).",
  "author": "NeuroPause",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings 0",
    "package": "node scripts/generate-build-info.cjs && electron-vite build && electron-builder --mac --arm64",
    "package:dir": "node scripts/generate-build-info.cjs && electron-vite build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:build-info": "node scripts/generate-build-info.cjs",
    "package:mac": "node scripts/generate-build-info.cjs && electron-vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@neuropause/shared": "*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "framer-motion": "^11.2.4",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3",
    "vite": "^5.2.11",
    "vitest": "^1.6.0",
    "zod": "^3.23.4"
  }
}
