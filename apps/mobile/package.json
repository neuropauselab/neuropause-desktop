{
  "name": "@neuropause/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "NeuroPause Mobile — the executive companion app (Expo + React Native). Standalone project: NOT part of the desktop npm workspaces; the shared packages are resolved by path (Metro + tsconfig).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-camera": "~15.0.16",
    "expo-local-authentication": "~14.0.1",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3",
    "vitest": "^1.6.1"
  }
}
