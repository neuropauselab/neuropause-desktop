# NeuroPause Backend — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).

# ── Runtime ──
NODE_ENV=development
PORT=4000
# Base URL the backend is reached at. OAuth redirect URIs are built from this as
# `${PUBLIC_BACKEND_URL}/auth/<provider>/callback`, so it must match what you
# register in each provider console EXACTLY (scheme, host, and port).
PUBLIC_BACKEND_URL=http://127.0.0.1:4000

# ── Data stores ──
DATABASE_URL=postgres://neuropause:neuropause@127.0.0.1:5432/neuropause
REDIS_URL=redis://127.0.0.1:6379

# ── JWT (auth tokens) ──
# Generate strong random secrets, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Billing (Razorpay) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_ENTERPRISE=

# ── Google OAuth (login) ──
# Create a "Web application" OAuth client at console.cloud.google.com
# (APIs & Services → Credentials), and register this authorized redirect URI:
#   http://127.0.0.1:4000/auth/google/callback
# The Client ID is not secret; the Client Secret MUST stay private (never commit).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
